# Generated local font/formatter caches and immutable solver output snapshots.
/.cache/
/output/

# Version the pinned scientific inputs and reconstruction evidence despite the
# broad generated-file rules above. Large downloaded kernels remain excluded.
!psyche_mission_events_reconstruction/**/*.json
!psyche_mission_events_reconstruction/artifacts/**/*.npz
!psyche_mission_events_reconstruction/artifacts/**/*.csv
