*.png
*.pyc
*.npz
*.csv
*.out
*.json

# Licensed solver
solvers/

# Downloaded JPL kernels (sources and hashes are saved with each solution).
data/jpl_kernels/

# Downloaded cartographic maps and orientation kernels (manifest is versioned).
data/planet_textures/*
!data/planet_textures/manifest.json

# Generated optimization summaries
output/**/summary.txt
output/**/*.log

# Generated local font/formatter caches and immutable solver output snapshots.
/.cache/
/output/
/.venv/
__pycache__/
.pytest_cache/
.ruff_cache/

# Version the pinned scientific inputs and reconstruction evidence despite the
# broad generated-file rules above. Large downloaded kernels remain excluded.
!data/psyche/**/*.json
!data/psyche/**/*.npz
!data/psyche/**/*.csv

!data/stochastic/*.npz
!data/stochastic/*.json
